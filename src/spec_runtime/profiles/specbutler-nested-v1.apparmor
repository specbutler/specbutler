# profile generated by github.com/moby/profiles/apparmor.


#include <tunables/global>

profile "specbutler-nested-v1" flags=(attach_disconnected,mediate_deleted) {
  network,
  # Disallow AF_ALG (Linux kernel crypto API); see https://copy.fail/
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer="unconfined",
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer="specbutler-nested-v1",

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # Nested sandbox setup. Kernel capability checks still apply: the worker
  # MUST run as a non-root uid, with all outer capabilities dropped and
  # no-new-privileges. Mount authority exists only in its new user namespace.
  userns,
  mount fstype=(tmpfs,proc,devpts,mqueue),
  mount options=(bind),
  mount options=(rbind),
  mount options=(rw,bind),
  mount options=(rw,rbind),
  mount options=(rw,silent,bind),
  mount options=(rw,silent,rbind),
  mount options=(rw,rslave),
  mount options=(rw,rprivate),
  mount options=(rw,silent,rslave),
  mount options=(rw,silent,rprivate),
  # Exact remount combinations: bind + remount + silent + nosuid are
  # mandatory; Bubblewrap preserves the source mount access/atime flags.
  mount options=(rw,remount,bind,silent,nosuid),
  mount options=(rw,remount,bind,silent,nosuid,relatime),
  mount options=(rw,remount,bind,silent,nosuid,nodiratime),
  mount options=(rw,remount,bind,silent,nosuid,nodiratime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,noatime),
  mount options=(rw,remount,bind,silent,nosuid,noatime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,noatime,nodiratime),
  mount options=(rw,remount,bind,silent,nosuid,noatime,nodiratime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,noexec),
  mount options=(rw,remount,bind,silent,nosuid,noexec,relatime),
  mount options=(rw,remount,bind,silent,nosuid,noexec,nodiratime),
  mount options=(rw,remount,bind,silent,nosuid,noexec,nodiratime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,noexec,noatime),
  mount options=(rw,remount,bind,silent,nosuid,noexec,noatime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,noexec,noatime,nodiratime),
  mount options=(rw,remount,bind,silent,nosuid,noexec,noatime,nodiratime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,nodev),
  mount options=(rw,remount,bind,silent,nosuid,nodev,relatime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,nodiratime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,nodiratime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noatime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noatime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noatime,nodiratime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noatime,nodiratime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noexec),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noexec,relatime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noexec,nodiratime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noexec,nodiratime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noexec,noatime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noexec,noatime,relatime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noexec,noatime,nodiratime),
  mount options=(rw,remount,bind,silent,nosuid,nodev,noexec,noatime,nodiratime,relatime),
  mount options=(ro,remount,bind,silent,nosuid),
  mount options=(ro,remount,bind,silent,nosuid,relatime),
  mount options=(ro,remount,bind,silent,nosuid,nodiratime),
  mount options=(ro,remount,bind,silent,nosuid,nodiratime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,noatime),
  mount options=(ro,remount,bind,silent,nosuid,noatime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,noatime,nodiratime),
  mount options=(ro,remount,bind,silent,nosuid,noatime,nodiratime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,noexec),
  mount options=(ro,remount,bind,silent,nosuid,noexec,relatime),
  mount options=(ro,remount,bind,silent,nosuid,noexec,nodiratime),
  mount options=(ro,remount,bind,silent,nosuid,noexec,nodiratime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,noexec,noatime),
  mount options=(ro,remount,bind,silent,nosuid,noexec,noatime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,noexec,noatime,nodiratime),
  mount options=(ro,remount,bind,silent,nosuid,noexec,noatime,nodiratime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,nodev),
  mount options=(ro,remount,bind,silent,nosuid,nodev,relatime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,nodiratime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,nodiratime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noatime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noatime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noatime,nodiratime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noatime,nodiratime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noexec),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noexec,relatime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noexec,nodiratime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noexec,nodiratime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noexec,noatime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noexec,noatime,relatime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noexec,noatime,nodiratime),
  mount options=(ro,remount,bind,silent,nosuid,nodev,noexec,noatime,nodiratime,relatime),
  pivot_root,


  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer="specbutler-nested-v1",
}
