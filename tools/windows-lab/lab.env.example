# Copy to lab.env and replace every angle-bracket placeholder.
# Keep this file local: lab.env is ignored by Git.
WINDOWS_ISO=/absolute/path/to/windows-11.iso
WINDOWS_ISO_SHA256="<windows-iso-sha256>"
WINDOWS_IMAGE_INDEX=1

# A cold baseline created after `labctl provision`. `labctl proof` resets to it.
LAB_BASELINE=provisioned

# Windows can spend several minutes completing a clean shutdown. Proof waits
# this long before refusing to reset an overlay that might still be in use.
LAB_SHUTDOWN_TIMEOUT_SECONDS=600

# Bound the Docker CLI itself after Windows receives its graceful deadline.
# This is separate from Compose's per-container stop grace period.
LAB_COMPOSE_DOWN_TIMEOUT_SECONDS=180
LAB_DOCKER_QUERY_TIMEOUT_SECONDS=30

# Wait briefly for the unattended desktop, then repair a missing session by
# passing the generated lab password over SSH stdin for one reboot. The
# controller removes the temporary Winlogon credential before running a job.
LAB_INTERACTIVE_SESSION_GRACE_SECONDS=30
LAB_INTERACTIVE_SESSION_REPAIR=1

# Automated proofs retain this many newest reset predecessors. Explicit
# `labctl reset` remains conservative and never prunes retired overlays.
LAB_PROOF_TRASH_KEEP=1

# GitHub owner under which proof creates a uniquely named private disposable repo.
# The authenticated guest `gh` user needs permission to create repositories here.
LAB_GITHUB_OWNER="<github-owner>"

# Absolute directory containing the hosted-CI aggregate and real Linux Claude
# result for the exact LAB_SOURCE_REF revision. See README.md.
SPEC_WINDOWS_ACCEPTANCE_EVIDENCE_ROOT=/absolute/path/to/exact-revision-evidence

LAB_SOURCE_REF=HEAD
LAB_CPUS=8
LAB_MEMORY=16G
LAB_DISK_SIZE=80G
LAB_SSH_PORT=12222
LAB_RDP_PORT=13390
LAB_VNC_PORT=16080
