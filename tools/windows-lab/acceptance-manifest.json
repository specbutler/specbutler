    {
      "id": "windows-web-autopilot.5",
      "spec_id": "windows-web-autopilot",
      "number": 5,
      "text": "`spec auto run` dispatches multiple dependency-ready specs on Windows up to the configured concurrency and never dispatches blocked dependents. After a forced dispatcher restart it reopens or transfers each durable supervision token, adopts every live implementation child exactly once, and neither terminates nor duplicates it; `spec auto stop` drains/terminates according to its documented contract.",
      "checks": [
        {"id": "web.5.status", "op": "json_equals", "artifact": "autopilot-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "web.5.concurrency", "op": "json_at_least", "artifact": "autopilot-result.json", "pointer": "/concurrency", "expected": 2},
        {"id": "web.5.ready", "op": "json_equals", "artifact": "autopilot-result.json", "pointer": "/dispatched_specs", "expected": ["auto-root-a", "auto-root-b"]},
        {"id": "web.5.blocked", "op": "json_equals", "artifact": "autopilot-result.json", "pointer": "/blocked_dependent_dispatch_count", "expected": 0},
        {"id": "web.5.launches", "op": "json_equals", "artifact": "autopilot-result.json", "pointer": "/launches_per_spec", "expected": 1},
        {"id": "web.5.adopt-a", "op": "json_equals", "artifact": "autopilot-result.json", "pointer": "/adoption_generation/auto-root-a", "expected": 1},
        {"id": "web.5.adopt-b", "op": "json_equals", "artifact": "autopilot-result.json", "pointer": "/adoption_generation/auto-root-b", "expected": 1},
        {"id": "web.5.stop", "op": "json_equals", "artifact": "autopilot-result.json", "pointer": "/graceful_auto_stop", "expected": true},
        {"id": "web.5.cleanup", "op": "json_equals", "artifact": "autopilot-result.json", "pointer": "/remaining_agent_processes", "expected": 0}
      ]
    },
    {
      "id": "windows-web-autopilot.6",
      "spec_id": "windows-web-autopilot",
