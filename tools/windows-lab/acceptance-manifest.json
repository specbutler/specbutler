  "criteria": [
    {
      "id": "windows-native-lifecycle.1",
      "spec_id": "windows-native-lifecycle",
      "number": 1,
      "text": "`spec create`, `spec task`, `spec implement`, `spec phase`, `spec report`, `spec input`, `spec status`, `spec stop`, `spec clean`, `spec gc`, and foreground `spec update` operate in a native Windows repository using the worktree backend and platform-valid Git paths.",
      "checks": [
        {"id": "native.1.matrix-status", "op": "json_equals", "artifact": "native-command-matrix-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "native.1.matrix-revision", "op": "json_equals", "artifact": "native-command-matrix-result.json", "pointer": "/source_revision", "expected": "${SOURCE_REVISION}"},
        {"id": "native.1.commands", "op": "json_equals", "artifact": "native-command-matrix-result.json", "pointer": "/commands", "expected": ["create", "task", "implement", "phase", "report", "input", "status", "stop", "clean", "gc", "update"]},
        {"id": "native.1.backend", "op": "json_equals", "artifact": "native-command-matrix-result.json", "pointer": "/backend", "expected": "worktree"}
      ]
    },
    {
      "id": "windows-native-lifecycle.2",
      "spec_id": "windows-native-lifecycle",
      "number": 2,
      "text": "A real Codex implementation run creates an isolated worktree, bootstraps it, edits and commits a fixture change, passes gates, performs review, opens and merges a pull request on a disposable GitHub repository, records provenance, and cleans up without manual repair.",
      "checks": [
        {"id": "native.2.status", "op": "json_equals", "artifact": "lifecycle-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "native.2.revision", "op": "json_equals", "artifact": "lifecycle-result.json", "pointer": "/source_revision", "expected": "${SOURCE_REVISION}"},
        {"id": "native.2.provider", "op": "json_equals", "artifact": "lifecycle-result.json", "pointer": "/provider", "expected": "codex"},
        {"id": "native.2.merged", "op": "json_equals", "artifact": "lifecycle-result.json", "pointer": "/pull_request_merged", "expected": true},
        {"id": "native.2.provenance", "op": "json_equals", "artifact": "lifecycle-result.json", "pointer": "/provenance_tag_present", "expected": true},
        {"id": "native.2.review", "op": "json_equals", "artifact": "lifecycle-result.json", "pointer": "/review_decision", "expected": "approved"},
        {"id": "native.2.review-bootstrap", "op": "json_equals", "artifact": "lifecycle-result.json", "pointer": "/review_bootstrap_warning_present", "expected": false},
        {"id": "native.2.cleanup", "op": "json_equals", "artifact": "lifecycle-result.json", "pointer": "/implementation_workspaces_remaining", "expected": 0},
        {"id": "native.2.review-evidence", "op": "json_equals", "artifact": "review-decision.json", "pointer": "/status", "expected": "approved"},
        {"id": "native.2.log", "op": "artifact_nonempty", "artifact": "real-codex-lifecycle.log"}
      ]
    },
    {
      "id": "windows-native-lifecycle.3",
      "spec_id": "windows-native-lifecycle",
      "number": 3,
      "text": "Stop, timeout, failed gate, review retry, resume after orchestrator restart, stale state, merge-conflict recovery, and `needs-input` followed by `spec input` resolution are exercised on Windows. Owned subprocesses are gone afterward and unrelated processes are untouched.",
      "checks": [
        {"id": "native.3.status", "op": "json_equals", "artifact": "lifecycle-fault-matrix-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "native.3.revision", "op": "json_equals", "artifact": "lifecycle-fault-matrix-result.json", "pointer": "/source_revision", "expected": "${SOURCE_REVISION}"},
        {"id": "native.3.scenarios", "op": "json_equals", "artifact": "lifecycle-fault-matrix-result.json", "pointer": "/scenarios", "expected": ["stop", "timeout", "failed-gate", "review-retry", "orchestrator-restart", "stale-state", "merge-conflict", "needs-input"]},
        {"id": "native.3.owned-gone", "op": "json_equals", "artifact": "lifecycle-fault-matrix-result.json", "pointer": "/owned_processes_remaining", "expected": 0},
        {"id": "native.3.unrelated", "op": "json_equals", "artifact": "lifecycle-fault-matrix-result.json", "pointer": "/unrelated_process_preserved", "expected": true}
      ]
    },
    {
      "id": "windows-native-lifecycle.4",
      "spec_id": "windows-native-lifecycle",
      "number": 4,
      "text": "Codex home/config/auth isolation works without requiring symlink privileges or Developer Mode. Secrets are copied or referenced with least privilege and are absent from logs, commits, review workspaces, and cleanup remnants.",
      "checks": [
        {"id": "native.4.status", "op": "json_equals", "artifact": "isolation-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "native.4.no-symlinks", "op": "json_equals", "artifact": "isolation-result.json", "pointer": "/requires_symlink_privilege", "expected": false},
        {"id": "native.4.no-developer-mode", "op": "json_equals", "artifact": "isolation-result.json", "pointer": "/requires_developer_mode", "expected": false},
        {"id": "native.4.secret-locations", "op": "json_equals", "artifact": "isolation-result.json", "pointer": "/secret_occurrences", "expected": {"cleanup_remnants": 0, "commits": 0, "logs": 0, "review_workspaces": 0}}
      ]
    },
    {
      "id": "windows-native-lifecycle.5",
      "spec_id": "windows-native-lifecycle",
      "number": 5,
      "text": "Git and GitHub CLI discovery works from normal Windows installations. Commands tolerate drive-letter paths, backslashes, spaces, Unicode, CRLF output, and case-insensitive filesystem behavior.",
      "checks": [
        {"id": "native.5.status", "op": "json_equals", "artifact": "windows-path-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "native.5.discovery", "op": "json_equals", "artifact": "windows-path-result.json", "pointer": "/discovery", "expected": {"gh": true, "git": true}},
        {"id": "native.5.path-cases", "op": "json_equals", "artifact": "windows-path-result.json", "pointer": "/cases", "expected": {"backslashes": true, "case_insensitive": true, "crlf": true, "drive_letter": true, "spaces": true, "unicode_non_cp1252": true}}
      ]
    },
    {
      "id": "windows-native-lifecycle.6",
      "spec_id": "windows-native-lifecycle",
      "number": 6,
      "text": "Security-sensitive reviewer/block-debugger paths use an isolation mechanism that is proven on Windows or fail closed with an actionable explanation. POSIX `chmod` or read-only file attributes are not presented as a security boundary.",
      "checks": [
        {"id": "native.6.status", "op": "json_equals", "artifact": "review-isolation-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "native.6.reviewer", "op": "json_in", "artifact": "review-isolation-result.json", "pointer": "/reviewer", "expected": ["isolated", "failed_closed"]},
        {"id": "native.6.block-debugger", "op": "json_in", "artifact": "review-isolation-result.json", "pointer": "/block_debugger", "expected": ["isolated", "failed_closed"]},
        {"id": "native.6.no-file-mode-boundary", "op": "json_equals", "artifact": "review-isolation-result.json", "pointer": "/file_attributes_claimed_as_boundary", "expected": false},
        {"id": "native.6.actionable", "op": "json_equals", "artifact": "review-isolation-result.json", "pointer": "/failures_actionable", "expected": true}
      ]
    },
    {
      "id": "windows-native-lifecycle.7",
      "spec_id": "windows-native-lifecycle",
      "number": 7,
      "text": "Native Claude execution remains explicitly unavailable while its required host sandbox is unsupported; selection fails before launch with documented alternatives and does not weaken sandbox policy.",
      "checks": [
        {"id": "native.7.status", "op": "json_equals", "artifact": "native-claude-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "native.7.prelaunch", "op": "json_equals", "artifact": "native-claude-result.json", "pointer": "/failed_before_launch", "expected": true},
        {"id": "native.7.provider-starts", "op": "json_equals", "artifact": "native-claude-result.json", "pointer": "/provider_processes_started", "expected": 0},
        {"id": "native.7.alternatives", "op": "json_at_least", "artifact": "native-claude-result.json", "pointer": "/documented_alternatives", "expected": 1},
        {"id": "native.7.policy", "op": "json_equals", "artifact": "native-claude-result.json", "pointer": "/sandbox_policy_weakened", "expected": false}
      ]
    },
    {
      "id": "windows-native-lifecycle.8",
      "spec_id": "windows-native-lifecycle",
      "number": 8,
      "text": "Foreground update checks and applies through the documented safety gates. The background refresh mode uses the detached lifetime from `windows-process-supervision`, survives CLI exit, records durable identity, and leaves no stale process or state after completion.",
      "checks": [
        {"id": "native.8.status", "op": "json_equals", "artifact": "update-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "native.8.foreground", "op": "json_equals", "artifact": "update-result.json", "pointer": "/foreground_applied", "expected": true},
        {"id": "native.8.background-survived", "op": "json_equals", "artifact": "update-result.json", "pointer": "/background_survived_cli_exit", "expected": true},
        {"id": "native.8.identity", "op": "json_equals", "artifact": "update-result.json", "pointer": "/durable_identity_recorded", "expected": true},
        {"id": "native.8.cleanup", "op": "json_equals", "artifact": "update-result.json", "pointer": "/remaining_processes_and_state", "expected": 0}
      ]
    },
    {
      "id": "windows-native-lifecycle.9",
      "spec_id": "windows-native-lifecycle",
      "number": 9,
      "text": "Hermetic Windows integration tests cover the lifecycle without model, network, or real-forge dependencies, and a separately marked real-provider proof test covers the end-to-end Codex path.",
      "checks": [
        {"id": "native.9.status", "op": "json_equals", "artifact": "test-coverage-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "native.9.hermetic", "op": "json_equals", "artifact": "test-coverage-result.json", "pointer": "/hermetic_lifecycle", "expected": true},
        {"id": "native.9.real-mark", "op": "json_equals", "artifact": "test-coverage-result.json", "pointer": "/real_provider_separately_marked", "expected": true},
        {"id": "native.9.real-e2e", "op": "json_equals", "artifact": "lifecycle-result.json", "pointer": "/status", "expected": "passed"}
      ]
    },
    {
      "id": "windows-native-lifecycle.10",
      "spec_id": "windows-native-lifecycle",
      "number": 10,
      "text": "Linux/macOS lifecycle behavior and state compatibility remain unchanged.",
      "checks": [
        {"id": "native.10.status", "op": "json_equals", "artifact": "cross-platform-lifecycle-result.json", "pointer": "/status", "expected": "passed"},
