    {
      "id": "windows-web-autopilot.1",
      "spec_id": "windows-web-autopilot",
      "number": 1,
      "text": "`spec web` starts in foreground and background modes on Windows, serves the authenticated application, reaches readiness deterministically, and stops without leaving server or action subprocesses alive.",
      "checks": [
        {"id": "web.1.status", "op": "json_equals", "artifact": "web-lifecycle-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "web.1.foreground", "op": "json_equals", "artifact": "web-lifecycle-result.json", "pointer": "/foreground", "expected": "passed"},
        {"id": "web.1.background", "op": "json_equals", "artifact": "web-lifecycle-result.json", "pointer": "/background", "expected": "passed"},
        {"id": "web.1.auth", "op": "json_equals", "artifact": "web-lifecycle-result.json", "pointer": "/authenticated_readiness", "expected": true},
        {"id": "web.1.cleanup", "op": "json_equals", "artifact": "web-lifecycle-result.json", "pointer": "/remaining_server_and_action_processes", "expected": 0}
      ]
    },
    {
      "id": "windows-web-autopilot.2",
      "spec_id": "windows-web-autopilot",
      "number": 2,
      "text": "Real Codex web chat is tested through the running HTTP/WebSocket interface for at least three turns. The second and third responses demonstrably depend on facts supplied only in earlier turns, refresh/reconnect preserves the intended session, separate chats do not leak context, and cancellation leaves no child process.",
      "checks": [
        {"id": "web.2.status", "op": "json_equals", "artifact": "web-chat-result.json", "pointer": "/status", "expected": "passed"},
        {"id": "web.2.provider", "op": "json_equals", "artifact": "web-chat-result.json", "pointer": "/backend", "expected": "codex"},
        {"id": "web.2.turns", "op": "json_at_least", "artifact": "web-chat-result.json", "pointer": "/dependent_turns", "expected": 3},
        {"id": "web.2.turn2", "op": "json_equals", "artifact": "web-chat-result.json", "pointer": "/turn_2_retained_turn_1", "expected": true},
        {"id": "web.2.turn3", "op": "json_equals", "artifact": "web-chat-result.json", "pointer": "/turn_3_retained_turns_1_and_2", "expected": true},
        {"id": "web.2.reconnect", "op": "json_equals", "artifact": "web-chat-result.json", "pointer": "/reconnect_endpoint_exercised", "expected": true},
        {"id": "web.2.isolation", "op": "json_equals", "artifact": "web-chat-result.json", "pointer": "/concurrent_sessions_isolated", "expected": true},
        {"id": "web.2.cancellation", "op": "json_equals", "artifact": "web-chat-result.json", "pointer": "/cancelled_descendants_remaining", "expected": 0}
      ]
    },
    {
      "id": "windows-web-autopilot.3",
      "spec_id": "windows-web-autopilot",
      "number": 3,
      "text": "Claude chat remains available where the existing supported isolation/runtime is present. On native Windows it is hidden or disabled with a precise explanation rather than launched without its sandbox; Linux regression tests exercise a real multi-turn Claude session when credentials are available.",
