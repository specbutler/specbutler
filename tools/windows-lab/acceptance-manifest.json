    {
      "id": "windows-web-autopilot.4",
      "spec_id": "windows-web-autopilot",
      "number": 4,
      "text": "Web lifecycle actions invoke the same runtime and process-supervision paths as the CLI and report structured failures rather than POSIX tracebacks.",
