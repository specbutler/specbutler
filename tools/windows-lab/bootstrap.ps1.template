$ErrorActionPreference = 'Stop'
$root = 'C:\SpecHarness'
$log = Join-Path $root 'bootstrap.log'
New-Item -ItemType Directory -Force -Path $root | Out-Null
Start-Transcript -Path $log -Append

try {
    powercfg.exe /change standby-timeout-ac 0
    powercfg.exe /change hibernate-timeout-ac 0

    $capability = Get-WindowsCapability -Online -Name 'OpenSSH.Server~~~~0.0.1.0'
    if ($capability.State -ne 'Installed') {
        Add-WindowsCapability -Online -Name 'OpenSSH.Server~~~~0.0.1.0' | Out-Null
    }
    Set-Service -Name sshd -StartupType Automatic
    $firewall = Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue
    if (-not $firewall) {
        New-NetFirewallRule `
            -Name 'OpenSSH-Server-In-TCP' `
            -DisplayName 'OpenSSH Server (sshd)' `
            -Enabled True `
            -Profile Any `
            -Direction Inbound `
            -Protocol TCP `
            -Action Allow `
            -LocalPort 22 | Out-Null
    } else {
        Set-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -Enabled True -Profile Any | Out-Null
    }

    $sshRoot = Join-Path $env:ProgramData 'ssh'
    New-Item -ItemType Directory -Force -Path $sshRoot | Out-Null
    $authorizedKeys = Join-Path $sshRoot 'administrators_authorized_keys'
    Set-Content -LiteralPath $authorizedKeys -Encoding ascii -Value '__SSH_PUBLIC_KEY__'
    icacls.exe $authorizedKeys /inheritance:r /grant '*S-1-5-32-544:F' /grant 'SYSTEM:F' | Out-Null

    New-Item -Path 'HKLM:\SOFTWARE\OpenSSH' -Force | Out-Null
    New-ItemProperty -Path 'HKLM:\SOFTWARE\OpenSSH' -Name DefaultShell -Value "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe" -PropertyType String -Force | Out-Null
    $sshdConfig = Join-Path $sshRoot 'sshd_config'
    $lines = @(Get-Content -LiteralPath $sshdConfig) | Where-Object {
        $_ -notmatch '^\s*#?\s*(PasswordAuthentication|PubkeyAuthentication)\s+'
    }
    $lines += 'PubkeyAuthentication yes'
    $lines += 'PasswordAuthentication no'
    Set-Content -LiteralPath $sshdConfig -Encoding ascii -Value $lines
    & "$env:SystemRoot\System32\OpenSSH\sshd.exe" -t -f $sshdConfig
    if ($LASTEXITCODE -ne 0) { throw "sshd validation failed with exit code $LASTEXITCODE" }
    Restart-Service sshd -ErrorAction SilentlyContinue
    if ((Get-Service sshd).Status -ne 'Running') { Start-Service sshd }

    Enable-NetFirewallRule -DisplayGroup 'Remote Desktop' -ErrorAction SilentlyContinue
    Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -Name fDenyTSConnections -Value 0
    Set-Content -LiteralPath (Join-Path $root 'bootstrap.ready') -Encoding ascii -Value (Get-Date).ToString('o')
} finally {
    Stop-Transcript
}
